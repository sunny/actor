#!/usr/bin/env ruby
# frozen_string_literal: true

require "pathname"
require "stringio"

class LoaderGenerator
  def initialize(loader_path, load_path, output = nil)
    @loader_path = loader_path
    @load_path = load_path
    @output = output
  end

  def call
    writer do |out|
      out.puts <<~HEADER
        # frozen_string_literal: true

        # Generated by bin/loader. Do not edit manually.

      HEADER

      loaders = []
      register = lambda do |loader|
        loader.on_load do |_constant_path, _value, absolute_path|
          next unless absolute_path.end_with?(".rb")

          out.puts %(require "#{requirement_for(absolute_path)}")
        end
        loaders << loader
      end

      yield(register)
      loaders.each(&:eager_load)
    end

    true
  end

  private

  attr_reader :loader_path, :load_path, :output

  def writer(&block)
    output ? block.call(output) : File.open(loader_path, "w", &block)
  end

  def requirement_for(absolute_path)
    Pathname.new(absolute_path)
      .relative_path_from(Pathname.new(load_path))
      .to_s
      .delete_suffix(".rb")
  end
end

class LoaderValidator
  def initialize(loader_path, load_path)
    @loader_path = loader_path
    @load_path = load_path
  end

  def call(&block)
    generated = StringIO.new
    LoaderGenerator.new(loader_path, load_path, generated).call(&block)
    generated.string == File.read(loader_path)
  end

  private

  attr_reader :loader_path, :load_path
end

require "bundler/setup"

load_path = File.expand_path("../lib", __dir__)
loader_path = File.join(load_path, "service_actor/support/basic_loader.rb")
action = (ARGV.first == "generate") ? LoaderGenerator : LoaderValidator

valid = action.new(loader_path, load_path).call do |register|
  ServiceActor::AUTOLOADERS.define_singleton_method(:<<) do |loader|
    register.call(loader)
    super(loader)
  end

  require "service_actor"
end

exit(1) unless valid
